// Tally's data model. DESIGN.md explains the tenant-isolation rules this schema carries:
// every tenant-owned table has organization_id, row-level security (written into the SQL
// migrations, since the schema language can't express it), and composite foreign keys so a row
// can only reference rows of its own organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID

  @@map("invoice_status")
}

// Not tenant-owned: a user can belong to several organizations.
model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored trimmed and lower-cased (src/server/auth/schemas.ts); the unique index is on that form.
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  Membership[]

  @@map("users")
}

// The tenant.
model Organization {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  Membership[]
  customers    Customer[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]

  @@map("organizations")
}

model Membership {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// Tenant-owned from here down: row-level security in migrations/*_row_level_security.
model Customer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  // The target of invoices' composite foreign key.
  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@map("customers")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  // Assigned when a draft is finalized (D2), so the numbers customers see have no gaps.
  number         Int?
  status         InvoiceStatus @default(DRAFT)
  currency       String        @db.Char(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // By (organization_id, customer_id): another organization's customer can't be referenced.
  // NoAction, not Restrict: Postgres checks NO ACTION at the end of the statement, so deleting an
  // organization (which cascades to its customers and its invoices together) succeeds, while
  // deleting a customer that still has invoices fails. onUpdate NoAction: ids never change, and a
  // cascade would carry invoices along if a customer's organization_id were ever changed.
  customer       Customer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines          InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, customerId])
  @@map("invoices")
}

model InvoiceLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  position       Int
  description    String
  quantity       Decimal      @db.Decimal(12, 3)
  // Integer minor units (cents for USD); never floating point.
  unitPriceMinor BigInt       @map("unit_price_minor")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invoiceId, position])
  @@index([organizationId, invoiceId])
  @@map("invoice_lines")
}
