// Tally's data model. DESIGN.md explains the tenant-isolation rules this schema carries:
// every tenant-owned table has organization_id, row-level security (written into the SQL
// migrations, since the schema language can't express it), and composite foreign keys so a row
// can only reference rows of its own organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID

  @@map("invoice_status")
}

// A payment attempt's life (DESIGN.md, "Billing"). PENDING: a checkout session exists and nobody has paid;
// PROCESSING: the customer finished checkout with a payment method that settles later (bank debits);
// SUCCEEDED: money arrived. FAILED and EXPIRED end an attempt without money, but a late success still
// records (money that moved is never ignored); SUCCEEDED is final. The payments_guard trigger enforces it.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED

  @@map("payment_status")
}

// Not tenant-owned: a user can belong to several organizations. Ids are immutable everywhere (onUpdate
// NoAction): an id change would otherwise cascade into other rows without row security.
model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored trimmed and lower-cased (src/server/auth/schemas.ts); the unique index is on that form.
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  memberships  Membership[]

  @@map("users")
}

// The tenant.
model Organization {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  memberships    Membership[]
  customers      Customer[]
  invoices       Invoice[]
  invoiceLines   InvoiceLine[]
  invoiceCounter InvoiceCounter?
  payments       Payment[]
  stripeEvents   StripeEvent[]
  invitations    Invitation[]

  @@map("organizations")
}

model Membership {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// Tenant-owned from here down: row-level security in migrations/*_row_level_security.
model Customer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String
  // Free text printed under the name on invoices (several lines).
  address        String?
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices       Invoice[]

  // The target of invoices' composite foreign key.
  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@map("customers")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  // Assigned by the database when a draft is finalized (the invoices_guard trigger, from invoice_counters),
  // so the numbers customers see have no gaps. The application can't write it.
  number         Int?
  status         InvoiceStatus @default(DRAFT)
  // Fixed at creation: prices are in this currency's minor unit, so changing it would rescale every line.
  currency       String        @db.Char(3)
  memo           String?
  // Set by the trigger at finalization, never by the application: when it was issued and what it totals.
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(3)
  dueOn          DateTime?     @map("due_on") @db.Date
  subtotalMinor  BigInt?       @map("subtotal_minor")
  taxMinor       BigInt?       @map("tax_minor")
  totalMinor     BigInt?       @map("total_minor")
  // Who it was issued to, copied from the customer at finalization (an issued invoice doesn't change when the
  // customer is edited later). Null while a draft, whose page and PDF show the customer as it is.
  billToName     String?       @map("bill_to_name")
  billToEmail    String?       @map("bill_to_email")
  billToAddress  String?       @map("bill_to_address")
  createdAt      DateTime      @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // By (organization_id, customer_id): another organization's customer can't be referenced.
  // NoAction, not Restrict: Postgres checks NO ACTION at the end of the statement, so deleting an
  // organization (which cascades to its customers and its invoices together) succeeds, while
  // deleting a customer that still has invoices fails. onUpdate NoAction: ids never change, and a
  // cascade would carry invoices along if a customer's organization_id were ever changed.
  customer       Customer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, customerId])
  @@map("invoices")
}

model InvoiceLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  position       Int
  description    String
  quantity       Decimal      @db.Decimal(12, 3)
  // Integer minor units (cents for USD); never floating point.
  unitPriceMinor BigInt       @map("unit_price_minor")
  // A percentage with three decimals (8.875), 0 to 100.
  taxRate        Decimal      @default(0) @map("tax_rate") @db.Decimal(6, 3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice        Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  // Unique per organization, not per invoice id alone: unique checks ignore row-level security, so a
  // (invoice_id, position) key would answer "taken" for another tenant's invoice and "no such invoice" for
  // a random id. With organization_id first, the key never collides across tenants. It also serves the
  // (organization_id, invoice_id) lookups the old separate index did.
  @@unique([organizationId, invoiceId, position])
  @@map("invoice_lines")
}

// The last invoice number an organization issued. The finalizing UPDATE's trigger increments it with an
// upsert, which locks this row until the transaction ends: finalizations in one organization take turns, and a
// rollback hands the number back, so numbers have no gaps.
model InvoiceCounter {
  organizationId String       @id @map("organization_id") @db.Uuid
  lastNumber     Int          @map("last_number")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("invoice_counters")
}

// One attempt to collect an open invoice through the payment provider: a hosted checkout session for the
// invoice's stored total. The payments_guard trigger checks the amount and currency against the invoice when
// the row is created and freezes everything but the outcome afterwards.
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  // "mock" or "stripe": which provider created the session (a mock session can't be paid on Stripe).
  provider          String
  // The provider's checkout session id (cs_...), what webhook events name.
  checkoutSessionId String        @map("checkout_session_id")
  // The hosted payment page the customer is sent to.
  checkoutUrl       String        @map("checkout_url")
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  // Set from the event that reported the money (Stripe's PaymentIntent id and the event's time).
  paymentIntentId   String?       @map("payment_intent_id")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  // Money arrived for an invoice that no longer wanted it (already paid, voided) or for the wrong amount:
  // someone has to refund it. Only ever set, never cleared, by the application.
  refundDue         Boolean       @default(false) @map("refund_due")
  createdAt         DateTime      @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // NoAction like invoices -> customers: only drafts can be deleted and drafts never have payments, while an
  // organization's deletion removes both in one statement.
  invoice           Invoice       @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  events            StripeEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, checkoutSessionId])
  @@index([organizationId, invoiceId])
  @@map("payments")
}

// The webhook inbox: one row per provider event that changed (or was checked against) a payment, keyed by the
// provider's event id. Inserting it is the first statement of the event's transaction, so a second delivery of
// the same event waits for the first and then finds it: each event takes effect exactly once.
model StripeEvent {
  // Stripe's event id (evt_...), unique across Stripe; only signed events reach the insert.
  id              String       @id
  organizationId  String       @map("organization_id") @db.Uuid
  type            String
  paymentId       String?      @map("payment_id") @db.Uuid
  // What processing did ("invoice-paid", "stale", ...); null only inside the processing transaction.
  outcome         String?
  // The event's own creation time (Stripe's `created`), and when it arrived here.
  stripeCreatedAt DateTime     @map("stripe_created_at") @db.Timestamptz(3)
  receivedAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("received_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment         Payment?     @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, paymentId])
  @@map("stripe_events")
}

// An invitation to join an organization with a role (DESIGN.md, "Members and invitations"). The link carries a
// random token; only its SHA-256 digest is stored. The invitations_guard trigger keeps it open until it is
// accepted (before it expires) or revoked, once, and takes every time from the database's clock.
model Invitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  // Stored trimmed and lower-cased, like users' emails; only the user with this email can accept.
  email          String
  role           Role
  tokenHash      Bytes        @map("token_hash")
  // Who invited (a user id, kept as a record: no foreign key, so deleting that user leaves the history).
  invitedBy      String       @map("invited_by") @db.Uuid
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime     @default(dbgenerated("(clock_timestamp() + '7 days'::interval)")) @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz(3)
  acceptedBy     String?      @map("accepted_by") @db.Uuid
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, id])
  // Unique per organization (unique checks ignore row security, so keys on tenant tables start with
  // organization_id); the link names the organization, so the lookup is by both.
  @@unique([organizationId, tokenHash])
  @@map("invitations")
}
