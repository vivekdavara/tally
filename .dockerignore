# The build context: what `COPY . .` can see. Secrets and local build output never go in. A .env here would be
# copied into the image by Next.js's standalone output (it copies the project's .env files next to server.js).
.env
.env.*
.git
.github
node_modules
.next
dist
src/generated
.scratch
coverage
test-results
playwright-report
*.tsbuildinfo
*.log
.DS_Store
# tests/ and e2e/ stay: next build type-checks the whole project, and scripts/ import test fixtures.
