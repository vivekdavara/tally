# Copy to .env (gitignored). Local Postgres trusts local connections, so there are no database passwords.
# The application connects as tally_app, which row-level security binds.
DATABASE_URL=postgresql://tally_app@localhost:5432/tally
# Migrations connect as tally_owner, which owns the tables.
MIGRATE_DATABASE_URL=postgresql://tally_owner@localhost:5432/tally
# Auth.js encrypts its session cookie with this. Generate one: openssl rand -base64 32
AUTH_SECRET=
# Production mode (next start) on localhost or behind a proxy: let Auth.js trust the Host header. `next dev`
# doesn't need it. Leave it unset where the platform sets AUTH_URL instead.
# AUTH_TRUST_HOST=true
# Billing. The mock provider is the default and needs nothing: payment links open /mock-checkout/<session>, where
# you play the customer. Stripe's test mode is opt-in, with your own test keys (a live key is refused at startup):
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      (the endpoint's signing secret, e.g. from `stripe listen`)
# Where checkout sends the customer back (Stripe needs an absolute URL).
# APP_BASE_URL=http://localhost:8117
